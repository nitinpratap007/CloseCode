{
  "name": "closecode",
  "productName": "CloseCode",
  "version": "0.1.0",
  "description": "A fast, modern, open-source desktop code editor",
  "main": "dist-electron/main.js",
  "author": "Close Code Contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "electron .",
    "dist": "npm run build && node scripts/build.cjs prod",
    "package:dir": "npm run build && node scripts/build.cjs dev",
    "build:dev": "npm run build && node scripts/build.cjs dev",
    "build:prod": "npm run build && node scripts/build.cjs prod",
    "build:installer": "npm run build && node scripts/build.cjs installer",
    "build:portable": "npm run build && node scripts/build.cjs portable",
    "build:win": "npm run build && node scripts/build.cjs win",
    "build:mac": "npm run build && node scripts/build.cjs mac",
    "build:linux": "npm run build && node scripts/build.cjs linux",
    "build:all": "npm run build && node scripts/build.cjs all",
    "test:smoke": "node scripts/smoke-test.cjs",
    "test:settings": "node scripts/settings-test.cjs",
    "test:unit": "vitest run",
    "test:all": "node scripts/test-all.cjs",
    "verify:asar": "node scripts/verify-asar.cjs",
    "test:phase2": "node scripts/phase2-test.cjs",
    "test:phase3": "node scripts/phase3-test.cjs",
    "test:phase4": "node scripts/phase4-test.cjs",
    "test:phase5": "node scripts/phase5-test.cjs",
    "test:phase6": "node scripts/phase6-test.cjs",
    "test:phase7": "node scripts/phase7-test.cjs",
    "test:phase8": "node scripts/phase8-test.cjs",
    "test:phase9": "node scripts/phase9-test.cjs",
    "test:phase10": "node scripts/phase10-test.cjs",
    "test:phase11": "node scripts/phase11-test.cjs",
    "test:phase12": "node scripts/phase12-test.cjs",
    "test:phase13": "node scripts/phase13-test.cjs",
    "test:phase14": "node scripts/phase14-test.cjs",
    "test:phase15": "node scripts/phase15-test.cjs",
    "test:phase17": "node scripts/phase17-test.cjs",
    "test:phase19": "node scripts/e2e-test.cjs",
    "profile:phase16": "node scripts/phase16-profile.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "electron": "^35.3.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.0.1"
  }
}
